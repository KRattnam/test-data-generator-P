# Test Data Generator - Environment Configuration --
# Application 
APP_NAME=test-data-generator
APP_NAME=development
APP_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL Database

POSTGRES_HOST=localhost

POSTGRES_PORT=5432
POSTGRES_DB=tdg
POSTGRES_USER=tdg_user
POSTGRES_PASSWORD=tdg_password

# Redis 

REDIS_HOST=localhost
REDIS_PORT=6379
REDIST+DB=0

# GENERATION SETTINGS 

DEFAULT_PROFILE=residential_smart
MAX_RECORDS_PER_RUN=10000
MAX_RETRIES_PER_ENTITIY=3
GENERATION_TIMEOUT_SECONDS=300

# Export Settings
EXPORT_DIR=./exports
EXPORT_MAX_FILE_SIZE_MB=100

# Observabiity

prometheus_port=9090
enable_metrics=true

